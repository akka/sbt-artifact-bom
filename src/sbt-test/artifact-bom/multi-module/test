# Internal modules are excluded by default, while their external dependencies remain.
> app/compile
$ exists artifact-bom/app/pom.xml
> app/checkBom false

# The Global default must allow a ThisBuild override.
> set ThisBuild / makeBomIncludeInternalDependencies := true
> app/makeBom
> app/checkBom true

# A project override must take precedence and regenerate the existing file.
> set app / makeBomIncludeInternalDependencies := false
> app/makeBom
> app/checkBom false

# Inclusion also works at project scope without deleting the generated file.
> set app / makeBomIncludeInternalDependencies := true
> app/makeBom
> app/checkBom true
